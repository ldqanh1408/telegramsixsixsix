<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lede</groupId>
        <artifactId>telegrambots</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>telegrambots-app</artifactId>
    <name>telegrambots-app</name>
    <description>Main Spring Boot runner and orchestration app</description>

    <dependencies>
        <!-- Internal Modules -->
        <dependency>
            <groupId>com.lede</groupId>
            <artifactId>telegrambots-shared</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lede</groupId>
            <artifactId>telegrambots-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lede</groupId>
            <artifactId>telegrambots-mongo</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lede</groupId>
            <artifactId>telegrambots-activation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lede</groupId>
            <artifactId>telegrambots-bot</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lede</groupId>
            <artifactId>telegrambots-telegram</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lede</groupId>
            <artifactId>telegrambots-notification</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lede</groupId>
            <artifactId>telegrambots-github</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lede</groupId>
            <artifactId>telegrambots-admin</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-docs</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
