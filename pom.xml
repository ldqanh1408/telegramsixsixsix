<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>
    <groupId>com.lede</groupId>
    <artifactId>telegrambots</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>telegrambots</name>
    <description>Multi-bot GitHub repo notifier for Telegram groups (MongoDB-backed) - Clean Architecture parent</description>

    <!--
      Clean Architecture (Onion) — Maven module per layer. The dependency rule is enforced by
      the reactor graph itself: each pom only declares the layers it is allowed to see.

          domain  ←  application  ←  infrastructure
                              ↖          web          ↙
                                       app (wires everything)

      - domain          : enterprise entities + value objects (pure Java, no framework)
      - application      : use cases, ports, pipeline abstraction (pure Java, depends on domain)
      - infrastructure   : Mongo/Telegram/security adapters implementing the ports (depends on application)
      - web              : controllers, DTOs, webhook pipelines (depends on application)
      - app              : Spring Boot bootstrap + bean wiring (depends on web + infrastructure)
    -->
    <modules>
        <module>telegrambots-domain</module>
        <module>telegrambots-application</module>
        <module>telegrambots-infrastructure</module>
        <module>telegrambots-web</module>
        <module>telegrambots-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal Modules -->
            <dependency>
                <groupId>com.lede</groupId>
                <artifactId>telegrambots-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lede</groupId>
                <artifactId>telegrambots-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lede</groupId>
                <artifactId>telegrambots-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lede</groupId>
                <artifactId>telegrambots-web</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
